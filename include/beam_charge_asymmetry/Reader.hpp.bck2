#pragma once

// C++ headers
#include <algorithm>
#include <filesystem>
#include <ranges>
#include <string>
#include <vector>
#include <cmath>

// <fmt> headers
#include <fmt/core.h>

// ROOT headers
#include <Math/Vector4D.h>
#include <Math/VectorUtil.h>
#include <TGraphErrors.h>
#include <TH1.h>

// Project headers
#include <hipo4/reader.h>
#include <Core/Draw.hpp>
#include <Core/Helpers.hpp>
#include <Core/Particle2.hpp>
#include <Core/ReadBank.hpp>
#include <beam_charge_asymmetry/Histograms.hpp>
#include <fplus.hpp>

namespace beam_charge_asymmetry {

class Reader {

    struct HistoBins {
        std::shared_ptr<TH1F> hist1_pi_plus_p;
        std::shared_ptr<TH1F> hist1_pi_plus_pt;
        std::shared_ptr<TH1F> hist1_pi_plus_z;
        std::shared_ptr<TH1F> hist1_pi_plus_theta;
        std::shared_ptr<TH1F> hist1_pi_plus_phih;

        std::unique_ptr<TH1D> hist1_pi_plus_p_binning;
        std::unique_ptr<TH1D> hist1_pi_plus_pt_binning;
        std::unique_ptr<TH1D> hist1_pi_plus_z_binning;
        std::unique_ptr<TH1D> hist1_pi_plus_theta_binning;
        std::unique_ptr<TH1D> hist1_pi_plus_phih_binning;

        HistoBins(int run_number, int bin_number) {
            hist1_pi_plus_p = std::make_shared<TH1F>((std::string("p_pi_plus") + std::to_string(run_number) + "_" + std::to_string(bin_number)).c_str(), "", 50, 0, 10);
            hist1_pi_plus_pt = std::make_shared<TH1F>((std::string("pt_pi_plus") + std::to_string(run_number) + "_" + std::to_string(bin_number)).c_str(), "", 50, 0, 4);
            hist1_pi_plus_z = std::make_shared<TH1F>((std::string("z_pi_plus") + std::to_string(run_number) + "_" + std::to_string(bin_number)).c_str(), "", 50, 0, 1);
            hist1_pi_plus_theta = std::make_shared<TH1F>((std::string("theta_pi_plus") + std::to_string(run_number) + "_" + std::to_string(bin_number)).c_str(), "", 50, 0, 1.570796);
            hist1_pi_plus_phih = std::make_shared<TH1F>((std::string("phih_pi_plus") + std::to_string(run_number) + "_" + std::to_string(bin_number)).c_str(), "", 50, -3.15, 3.15);

            hist1_pi_plus_p_binning = std::make_unique<TH1D>((std::string("p_pi_plus_binning") + std::to_string(run_number) + "_" + std::to_string(bin_number)).c_str(), "", 100, 0, 10);
            hist1_pi_plus_pt_binning = std::make_unique<TH1D>((std::string("pt_pi_plus_binning") + std::to_string(run_number) + "_" + std::to_string(bin_number)).c_str(), "", 100, 0, 4);
            hist1_pi_plus_z_binning = std::make_unique<TH1D>((std::string("z_pi_plus_binning") + std::to_string(run_number) + "_" + std::to_string(bin_number)).c_str(), "", 100, 0, 1);
            hist1_pi_plus_theta_binning = std::make_unique<TH1D>((std::string("theta_pi_plus_binning") + std::to_string(run_number) + "_" + std::to_string(bin_number)).c_str(), "", 100, 0, 1.570796);
            hist1_pi_plus_phih_binning = std::make_unique<TH1D>((std::string("phih_pi_plus_binning") + std::to_string(run_number) + "_" + std::to_string(bin_number)).c_str(), "", 100, -3.15, 3.15);
        }
    };

    struct tag1info {
        int event;
        long timestamp;

        std::strong_ordering operator<=> (const tag1info& rhs) const {
            return event <=> rhs.event;
        }
    };

    struct TriggerElectron {
        int sector1;
        int sector2;
        int sector3;
        int sector4;
        int sector5;
        int sector6;
    };

    struct Topology {
        std::vector<Core::Particle2> electrons;
        std::vector<Core::Particle2> pions_plus;
        std::vector<Core::Particle2> pions_minus;
    };

   private:
    // ****** private members
    Histograms& m_histograms;

    const double NaN = std::numeric_limits<double>::quiet_NaN();

    // ****** private methods

   public:
    // ****** constructors and destructor
    explicit Reader(Histograms& histograms);
    ~Reader();

    // ****** public methods
    auto operator()(const std::string& run) -> void;
};

}  // namespace beam_charge_asymmetry
